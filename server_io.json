{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.kairossignal/kairos-signal",
  "description": "DePIN network telemetry with the source, as_of time and an upstream verify URL on every value.",
  "version": "3.7.0",
  "websiteUrl": "https://kairossignal.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://kairossignal.com/mcp/"
    }
  ],
  "tools": [
    "find_networks",
    "get_network",
    "get_metric_history",
    "verify_value",
    "register_agent",
    "list_products",
    "purchase_data",
    "topup_credits",
    "check_balance",
    "list_datasets",
    "get_stats",
    "get_data_dictionary",
    "get_derivation_ledger",
    "fetch_dataset",
    "verify_footprint"
  ],
  "pricing": {
    "read_only_tools": "free, no key, within a daily per-IP quota",
    "data_products": "$0.49-$29.99 one-off (list_products for live prices)",
    "free_key": "$5 credits on registration (first 3 keys per IP per 30 days)",
    "design_partner": "$199/month"
  },
  "discovery": [
    "/.well-known/mcp.json",
    "/openapi.json",
    "/llms.txt",
    "/ai.txt",
    "/AGENTS.md"
  ],
  "repository": {
    "url": "https://github.com/OV3RK177/kairos-mcp-server",
    "source": "github"
  }
}
